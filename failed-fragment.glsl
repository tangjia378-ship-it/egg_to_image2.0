#version 450
layout(set=0,binding=0) uniform Globals {vec4 uEye,uEnv,uTint,uLight,uRes,uSettings;int uWater;};

layout(set=0,binding=1) uniform sampler2D uWave;
layout(set=0,binding=2) uniform sampler2D uScene;layout(location=0) in vec3 vWorld;
layout(location=1) in vec3 vNormal;
layout(location=2) in vec3 vLocal;in vec4 vColor,vData;layout(location=0) out vec4 color;
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
vec4 wave(vec2 p){ivec2 dims=textureSize(uWave,0);vec2 f=clamp((p+2.6)/5.2,vec2(0),vec2(.9999))*vec2(dims-1);ivec2 q=ivec2(f);vec2 a=fract(f);return mix(mix(texelFetch(uWave,q,0),texelFetch(uWave,min(q+ivec2(1,0),dims-1),0),a.x),mix(texelFetch(uWave,min(q+ivec2(0,1),dims-1),0),texelFetch(uWave,min(q+ivec2(1,1),dims-1),0),a.x),a.y);}
float caustic(vec2 p){float t=uEnv.x,a=sin(p.x*13.+t*.7+sin(p.y*9.-t*.4)),b=sin(p.y*14.-t*.63+sin(p.x*8.+t*.3));return pow(clamp(1.-abs(a+b)*1.25,0.,1.),5.)*.8;}
float occlusion(vec3 p){if(p.y>1.65)return 1.;float shade=1.;vec2 q=p.xz+vec2(-3.,5.)/7.*(2.07-p.y);vec2 roofs[6]=vec2[6](vec2(-0.71770,-0.24799),vec2(0.36644,-0.32895),vec2(-0.17302,0.61493),vec2(0.91112,0.53397),vec2(0.37166,1.47785),vec2(1.38000,1.94000));for(int j=0;j<6;j++){vec2 d=abs(q-roofs[j])-vec2(.31,.28);shade=min(shade,mix(.56,1.,smoothstep(-.02,.065,max(d.x,d.y))));}vec2 treePoint=p.xz+vec2(-3.,5.)/7.*(2.85-p.y);float crown=length((treePoint-vec2(-1.48,-1.48))/vec2(.98,.78));float dapples=.78+.22*sin(p.x*42.+sin(p.z*29.))*sin(p.z*36.);return shade*mix(dapples,1.,smoothstep(.65,1.05,crown));}
void main(){vec3 p=vWorld,n=normalize(vNormal),base=vColor.rgb;float mat=vData.x;if(uWater==1){bool top=mat<1.5;vec4 w=wave(p.xz);if(top&&w.b<.012)discard;vec2 uv=gl_FragCoord.xy/uRes.xy;vec2 offset=n.xz*(top?.012:.006);vec3 bg=texture(uScene,clamp(uv+offset,vec2(.001),vec2(.999))).rgb;float depth=top?max(.045,w.b):.31;vec3 absorption=exp(-vec3(1.9,.32,.18)*depth*.7);vec3 trans=bg*absorption+uTint.rgb*(1.-absorption)*.62;vec3 eye=normalize(uEye.xyz-p);float fres=.025+.26*pow(1.-abs(dot(eye,n)),3.);vec3 reflection=mix(vec3(.72,.89,.84),vec3(.94,.97,.91),max(n.y,0.));vec3 col=mix(trans,reflection,fres);col+=pow(max(dot(reflect(-normalize(uLight.xyz),n),eye),0.),100.)*.18;float edge=1.-smoothstep(0.,.035,min(2.6-abs(p.x),2.6-abs(p.z)));float lace=(1.-smoothstep(.02,.06,w.b))*step(.55,sin(p.x*43.+p.z*37.+uEnv.x*1.4)*.5+.5);float foam=clamp(w.g*.85+edge*.12+lace*.4,0.,.8);col=mix(col,vec3(.96,.99,.91),foam);if(!top)col=mix(col,uTint.rgb*.6,.10);color=vec4(col,top?1.:.73);return;}
if(mat==4.){color=vColor;return;}if(mat==3.){float grain=hash(floor(p.xz*110.)+p.y*13.);base*=.96+grain*.08;base=mix(base,vec3(.98,.94,.81),step(.994,grain)*step(.4,p.y)*.65);}if(mat==5.)base*=.92+sin((p.x+p.z*.4)*230.+sin(p.y*210.)*1.7)*.065+sin(p.y*170.)*.05;if(mat==6.){base*=.97+hash(floor(p.xz*220.))*.06;base=mix(base*vec3(.9,1.01,.94),base,smoothstep(uEnv.y-.08,uEnv.y+.02,p.y));}if(mat==7.)base*=.78+.22*smoothstep(-.4,.5,sin(p.x*130.+sin(p.z*90.)*2.+sin(p.y*85.)));if(mat==8.){if(vData.w==2.)base=mix(base,vec3(.16,.22,.24),step(.4,fract(vLocal.x*26.)));if(vData.w==3.)base=mix(base,vec3(.99,.94,.83),step(.72,fract((vLocal.x+.15)*25.)));if(vData.w==1.&&vLocal.x<-.072)base=vec3(.98,.84,.3);}if(mat==9.)base=mix(base,vec3(.99,.97,.9),step(.5,fract(atan(vLocal.z,vLocal.x)*1.90986)));if(mat==10.)base=mix(base,vec3(.85,.94,.88),step(.86,sin(vLocal.x*170.)*sin(vLocal.z*145.))*.8);float diffuse=max(0.,dot(n,normalize(uLight.xyz)));float hemi=.43+.22*(n.y*.5+.5);float shade=occlusion(p);vec3 col=base*(hemi*(.72+.28*shade)+diffuse*.53*shade)+base*pow(max(dot(n,normalize(vec3(-2,2,-3))),0.),2.)*.06;if(mat!=3.&&p.y<uEnv.y&&abs(p.x)<2.61&&abs(p.z)<2.61){float depth=max(0.,uEnv.y-p.y);vec3 absorption=exp(-vec3(1.1,.16,.12)*depth*.65);col=col*absorption+uTint.rgb*(1.-absorption)*.23;col+=caustic(p.xz)*(.07+.10*max(n.y,0.))*vec3(.65,1.,.9);}color=vec4(col,vColor.a);}